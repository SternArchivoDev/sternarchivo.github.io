name: Rust

on:
  push:
    branches: [ "master" ]
    tags: [ "v*" ]
  pull_request:
    branches: [ "master" ]
  workflow_dispatch:
    inputs:
      tag_version:
        description: 'Versione del tag (es. 1.2.3) - lascia vuoto per usare Cargo.toml'
        required: false
        type: string
      create_release:
        description: 'Crea release su GitHub?'
        required: false
        default: true
        type: boolean

env:
  CARGO_TERM_COLOR: always

# Permessi necessari per creare tag e release
permissions:
  contents: write

jobs:
  build:
    strategy:
      matrix:
        os: [ubuntu-latest, windows-latest]
    runs-on: ${{ matrix.os }}

    steps:
    - uses: actions/checkout@v4
      with:
        fetch-depth: 0

    - name: Build (debug)
      run: cargo build --verbose

    - name: Run tests
      run: cargo test --verbose

    - name: Extract package metadata
      id: meta
      run: |
        metadata=$(cargo metadata --format-version=1 --no-deps)
        name=$(echo "$metadata" | jq -r '.packages[0].name')
        version=$(echo "$metadata" | jq -r '.packages[0].version')
        bin_name=$(echo "$metadata" | jq -r '.packages[0].targets[] | select(.kind[] == "bin") | .name' | head -n1)
        if [ -z "$bin_name" ]; then
          bin_name="$name"
        fi
        echo "name=$name" >> $GITHUB_OUTPUT
        echo "version=$version" >> $GITHUB_OUTPUT
        echo "bin_name=$bin_name" >> $GITHUB_OUTPUT
      shell: bash

    # --- CONTROLLO OBBLIGATORIO (solo per tag o manuale con tag_version) ---
    - name: Check tag matches version
      if: |
        (startsWith(github.ref, 'refs/tags/') && github.event_name == 'push') ||
        (github.event_name == 'workflow_dispatch' && inputs.tag_version != '')
      run: |
        if [ "${{ github.event_name }}" == "workflow_dispatch" ]; then
          TAG_VERSION="${{ inputs.tag_version }}"
          echo "🔹 Usando versione manuale: $TAG_VERSION"
        else
          TAG="${{ github.ref_name }}"
          TAG_VERSION="${TAG#v}"
          echo "🔹 Usando versione dal tag: $TAG_VERSION"
        fi
        PACKAGE_VERSION="${{ steps.meta.outputs.version }}"
        echo "Versione specificata: $TAG_VERSION"
        echo "Versione da Cargo.toml: $PACKAGE_VERSION"
        if [ "$TAG_VERSION" != "$PACKAGE_VERSION" ]; then
          echo "❌ ERRORE: La versione '$TAG_VERSION' non corrisponde a Cargo.toml ('$PACKAGE_VERSION')"
          exit 1
        else
          echo "✅ Versione corrisponde!"
        fi
      shell: bash

    # --- Crea un tag temporaneo se eseguito manualmente con tag_version ---
    - name: Create temporary tag for manual release
      if: |
        github.event_name == 'workflow_dispatch' &&
        inputs.tag_version != '' &&
        inputs.create_release == true
      run: |
        TAG_NAME="v${{ inputs.tag_version }}"
        echo "🔹 Creando tag temporaneo: $TAG_NAME"
        git config user.name "github-actions[bot]"
        git config user.email "github-actions[bot]@users.noreply.github.com"
        if git rev-parse "$TAG_NAME" >/dev/null 2>&1; then
          echo "⚠️ Il tag $TAG_NAME esiste già. Verrà sovrascritto."
          git tag -f "$TAG_NAME"
        else
          git tag "$TAG_NAME"
        fi
        git push origin "$TAG_NAME" --force
        echo "✅ Tag creato e pushato: $TAG_NAME"
      shell: bash

    - name: Build release binary
      run: cargo build --release

    # --- Creazione pacchetto per Linux ---
    - name: Create distribution package (Linux)
      if: runner.os == 'Linux'
      run: |
        mkdir -p dist
        cp target/release/${{ steps.meta.outputs.bin_name }} dist/${{ steps.meta.outputs.name }}
        tar -czf ${{ steps.meta.outputs.name }}-${{ steps.meta.outputs.version }}.tar.gz -C dist ${{ steps.meta.outputs.name }}

    # --- Creazione pacchetto per Windows ---
    - name: Create distribution package (Windows)
      if: runner.os == 'Windows'
      run: |
        mkdir dist
        copy target\release\${{ steps.meta.outputs.bin_name }}.exe dist\${{ steps.meta.outputs.name }}.exe
        powershell -Command "Compress-Archive -Path dist\* -DestinationPath ${{ steps.meta.outputs.name }}-${{ steps.meta.outputs.version }}.zip"

    # --- Upload artifact su GitHub Actions (sempre) ---
    - name: Upload artifact
      uses: actions/upload-artifact@v4
      with:
        name: ${{ steps.meta.outputs.name }}-${{ steps.meta.outputs.version }}-${{ runner.os }}
        path: |
          ${{ steps.meta.outputs.name }}-${{ steps.meta.outputs.version }}.tar.gz
          ${{ steps.meta.outputs.name }}-${{ steps.meta.outputs.version }}.zip
        if-no-files-found: error

    # --- Crea Release su GitHub (solo su Linux) ---
    - name: Create GitHub Release
      if: |
        (startsWith(github.ref, 'refs/tags/') || github.event_name == 'workflow_dispatch') &&
        runner.os == 'Linux' &&
        inputs.create_release != false
      uses: softprops/action-gh-release@v2
      with:
        name: Release ${{ steps.meta.outputs.version }}
        body: |
          ## Release ${{ steps.meta.outputs.version }}
          - Eseguibili per Linux e Windows.
          - Pacchetti allegati.
        draft: false
        prerelease: false
        # Determina il tag da usare
        tag_name: ${{ 
          github.event_name == 'workflow_dispatch' && 
          inputs.tag_version != '' && 
          format('v{0}', inputs.tag_version) 
          || github.ref_name 
        }}
        files: |
          ${{ steps.meta.outputs.name }}-${{ steps.meta.outputs.version }}.tar.gz
          ${{ steps.meta.outputs.name }}-${{ steps.meta.outputs.version }}.zip
      env:
        GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}

    # --- Pulisce il tag temporaneo (opzionale) ---
    - name: Cleanup temporary tag
      if: |
        github.event_name == 'workflow_dispatch' &&
        inputs.tag_version != '' &&
        inputs.create_release == true &&
        always()
      run: |
        TAG_NAME="v${{ inputs.tag_version }}"
        echo "🔹 Rimuovendo tag temporaneo: $TAG_NAME"
        git push origin --delete "$TAG_NAME" || true
        git tag -d "$TAG_NAME" || true
      shell: bash
