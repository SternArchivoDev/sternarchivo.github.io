#!/usr/bin/env python3
import os
import platform
import shutil
import sys
import tempfile
import argparse
import subprocess
from datetime import datetime
from pathlib import Path

# -------- CONFIGURATION ----------
PROGRAM_NAME = "Neovim Configuration Skeleton Generator"
PROGRAM_VERSION = "0.0.1"
ITERATION_LEVEL = "alpha"
# --------------------------------

# Percorsi per il Neovim embedded (solo per debug/testing)
DEBUG_NVIM_BIN_win = Path(r"D:\Github\Private\Sources\Neovim Configs Generator\embed_nvim\nvim\WINDOWS\bin")
DEBUG_NVIM_BIN_linux = Path(r"D:\Github\Private\Sources\Neovim Configs Generator\embed_nvim\nvim\LINUX\bin")
DEBUG_NVIM_BIN_macos = Path(r"D:\Github\Private\Sources\Neovim Configs Generator\embed_nvim\nvim\MACOS\bin")

def get_nvim_executable() -> Path:
    """
    Restituisce il percorso dell'eseguibile di Neovim da usare.
    Se esiste un binario embedded per il sistema corrente, lo usa; altrimenti usa 'nvim' dal PATH.
    """
    system = platform.system()
    if system == "Windows":
        base = DEBUG_NVIM_BIN_win
        exe_name = "nvim.exe"
    elif system == "Linux":
        base = DEBUG_NVIM_BIN_linux
        exe_name = "nvim"
    elif system == "Darwin":
        base = DEBUG_NVIM_BIN_macos
        exe_name = "nvim"
    else:
        base = None
        exe_name = "nvim"

    if base is not None:
        candidate = base / exe_name
        if candidate.exists():
            return candidate
    # Fallback: cerca nel PATH
    return Path("nvim")


def get_standard_config_dir() -> Path:
    """Return the default Neovim config dir for the current OS."""
    system = platform.system()
    if system == "Windows":
        local_appdata = os.environ.get("LOCALAPPDATA")
        if local_appdata:
            return Path(local_appdata) / "nvim"
        return Path.home() / "AppData" / "Local" / "nvim"
    return Path.home() / ".config" / "nvim"


def _lazy_snippet() -> str:
    return """-- [[ Bootstrap Lazy.nvim ]]
-- local lazypath = vim.fn.stdpath("data") .. "/lazy/lazy.nvim"
-- if not vim.loop.fs_stat(lazypath) then
--   vim.fn.system({
--     "git", "clone", "--filter=blob:none",
--     "https://github.com/folke/lazy.nvim.git",
--     "--branch=stable", lazypath
--   })
-- end
-- vim.opt.rtp:prepend(lazypath)
--
-- require("lazy").setup({
--   -- Add your plugins here, e.g.
--   -- { 'catppuccin/nvim', name = 'catppuccin' },
-- })"""


def _packer_snippet() -> str:
    return """-- [[ Bootstrap Packer.nvim ]]
-- local fn = vim.fn
-- local install_path = fn.stdpath('data')..'/site/pack/packer/start/packer.nvim'
-- if fn.empty(fn.glob(install_path)) > 0 then
--   fn.system({'git', 'clone', '--depth', '1', 'https://github.com/wbthomason/packer.nvim', install_path})
-- end
-- vim.cmd [[packadd packer.nvim]]
--
-- require('packer').startup(function(use)
--   -- Add your plugins here, e.g.
--   -- use 'wbthomason/packer.nvim'
-- end)"""


def _other_snippet() -> str:
    return "-- [[ Add your plugin manager bootstrap or manual plugin loading here. ]]"


def create_skeleton(dest: Path, pkg_manager: str, gen_date: str) -> None:
    """
    Create the minimal directory and file structure inside `dest`.
    All text files are written with UTF-8 encoding.
    """
    dest.mkdir(parents=True, exist_ok=True)

    gen_print = f'''print("This configuration was generated by {PROGRAM_NAME} on {gen_date} with script version {PROGRAM_VERSION}")'''

    init_base = """-- Neovim minimal configuration skeleton
-- This file is the entry point. Add your own settings and module loads.

-- --------------------------------------------------------------
-- Generation information (printed at startup)
-- --------------------------------------------------------------
{gen_print}

-- --------------------------------------------------------------
-- Basic options (commented out)
-- --------------------------------------------------------------
-- Uncomment and adjust the options you need:
-- vim.opt.number = true
-- vim.opt.relativenumber = true
-- vim.opt.tabstop = 4
-- vim.opt.shiftwidth = 4
-- vim.opt.expandtab = true

-- Load your Lua modules (example)
-- require('user')

-- --------------------------------------------------------------
-- Package manager bootstrap template (commented out by default)
-- (your choice: {pkg_choice})
-- --------------------------------------------------------------
{pkg_snippet}

-- Put the rest of your configuration here
"""
    if pkg_manager == "lazy":
        snippet = _lazy_snippet()
    elif pkg_manager == "packer":
        snippet = _packer_snippet()
    else:
        snippet = _other_snippet()

    init_content = init_base.format(
        gen_print=gen_print,
        pkg_choice=pkg_manager,
        pkg_snippet=snippet
    )
    (dest / "init.lua").write_text(init_content, encoding="utf-8")

    lua_dir = dest / "lua"
    lua_dir.mkdir(exist_ok=True)

    user_dir = lua_dir / "user"
    user_dir.mkdir(exist_ok=True)

    user_init = """-- User-specific module
-- This file can be loaded via require('user') from init.lua
-- Add your own custom Lua code here.
"""
    (user_dir / "init.lua").write_text(user_init, encoding="utf-8")

    readme = f"""# Neovim Configuration Skeleton

This is a minimal, empty skeleton for Neovim configuration.

## Structure
- `init.lua` - main entry point (includes a commented bootstrap template for {pkg_manager})
- `lua/` - Lua modules
  - `user/` - your custom modules

## Usage
1. Edit `init.lua` to set options and load modules.
2. If you want to use the provided package manager template, uncomment the
   bootstrap block and add your plugins.
3. Place your additional Lua files in `lua/` or its subdirectories.

This skeleton is ready for you to build your own Neovim setup.
"""
    (dest / "README.md").write_text(readme, encoding="utf-8")


def copy_tree(src: Path, dst: Path) -> None:
    """Copy the entire tree from src to dst, overwriting if dst exists."""
    if dst.exists():
        shutil.rmtree(dst)
    shutil.copytree(str(src), str(dst))


def run_neovim_with_config(config_dir: Path, nvim_exe: Path) -> None:
    """
    Avvia Neovim usando config_dir come XDG_CONFIG_HOME.
    config_dir deve contenere una sottocartella 'nvim' con init.lua.
    """
    env = os.environ.copy()
    env["XDG_CONFIG_HOME"] = str(config_dir)
    print(f"Launching Neovim with XDG_CONFIG_HOME={config_dir}")
    try:
        subprocess.run([str(nvim_exe)], env=env)
    except FileNotFoundError:
        print(f"Error: Neovim executable not found at {nvim_exe}", file=sys.stderr)
        sys.exit(1)


def main() -> None:
    parser = argparse.ArgumentParser(
        description="Generate a Neovim configuration skeleton with a package manager template."
    )
    parser.add_argument(
        "-p", "--package-manager",
        choices=["lazy", "packer", "minimal", "other"],
        default="lazy",
        help="Package manager template to include (default: lazy)"
    )
    group = parser.add_mutually_exclusive_group(required=False)  # non più obbligatorio se usiamo --run
    group.add_argument(
        "-d", "--deploy",
        action="store_true",
        help="Deploy directly to the standard Neovim config directory"
    )
    group.add_argument(
        "-o", "--output",
        help="Output directory to copy the skeleton to"
    )
    parser.add_argument(
        "-r", "--run",
        action="store_true",
        help="After generating, launch Neovim with this configuration"
    )
    parser.add_argument(
        "-f", "--force",
        action="store_true",
        help="Overwrite existing directory without confirmation"
    )
    parser.add_argument(
        "-q", "--quiet",
        action="store_true",
        help="Suppress non‑error output"
    )
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="Show actions without writing to disk"
    )
    parser.add_argument(
        "--version",
        action="version",
        version=f"{PROGRAM_NAME} {PROGRAM_VERSION} ({ITERATION_LEVEL})"
    )
    args = parser.parse_args()

    # Se non viene specificato né --deploy né --output, ma viene usato --run,
    # genereremo in una cartella temporanea e la useremo per run.
    # Se non c'è --run e non c'è output/deploy, errore.
    if not (args.deploy or args.output or args.run):
        parser.error("At least one of --deploy, --output, or --run is required.")

    gen_date = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    temp_root = Path(tempfile.mkdtemp(prefix="neovim_skeleton_"))
    skeleton_path = temp_root / "nvim"

    try:
        create_skeleton(skeleton_path, args.package_manager, gen_date)
    except Exception as e:
        print(f"Error creating skeleton: {e}", file=sys.stderr)
        shutil.rmtree(temp_root)
        sys.exit(1)

    if args.dry_run:
        print(f"Dry run: would generate skeleton in {skeleton_path}")
        if args.deploy:
            target = get_standard_config_dir()
            print(f"Would deploy to: {target}")
        if args.output:
            print(f"Would copy to: {args.output}")
        if args.run:
            print("Would launch Neovim with this configuration")
        shutil.rmtree(temp_root)
        return

    # Determina la destinazione finale e la directory che conterrà la cartella 'nvim'
    final_nvim_dir = None
    parent_for_run = None  # sarà la directory da usare come XDG_CONFIG_HOME

    if args.deploy:
        target = get_standard_config_dir()
        if target.exists():
            if args.force:
                backup = target.parent / (target.name + "_backup")
                if backup.exists():
                    shutil.rmtree(backup)
                shutil.move(str(target), str(backup))
                if not args.quiet:
                    print(f"Existing config moved to: {backup}")
            else:
                if not args.quiet:
                    print(f"Target directory {target} already exists. Use --force to overwrite.")
                shutil.rmtree(temp_root)
                sys.exit(1)
        copy_tree(skeleton_path, target)
        final_nvim_dir = target
        parent_for_run = target.parent  # XDG_CONFIG_HOME sarà la parent di nvim (es. ~/.config)
        if not args.quiet:
            print(f"Configuration deployed to {target}")

    elif args.output:
        dest = Path(args.output)
        if dest.exists():
            if args.force:
                shutil.rmtree(dest)
            else:
                if not args.quiet:
                    print(f"Output directory {dest} already exists. Use --force to overwrite.")
                shutil.rmtree(temp_root)
                sys.exit(1)
        dest.parent.mkdir(parents=True, exist_ok=True)
        # Copia skeleton_path (che è una cartella 'nvim') dentro dest
        # Quindi final_nvim_dir sarà dest / "nvim"
        final_nvim_dir = dest / "nvim"
        copy_tree(skeleton_path, final_nvim_dir)
        parent_for_run = dest  # XDG_CONFIG_HOME = la directory che contiene 'nvim'
        if not args.quiet:
            print(f"Configuration copied to {final_nvim_dir}")

    else:
        # Solo --run: usiamo la temp_dir come configurazione
        # La temp_dir contiene già una cartella 'nvim'
        final_nvim_dir = skeleton_path
        parent_for_run = temp_root  # XDG_CONFIG_HOME = temp_root

    # Se --run è attivo, avvia Neovim
    if args.run:
        nvim_exe = get_nvim_executable()
        if not args.quiet:
            print(f"Using Neovim executable: {nvim_exe}")
        run_neovim_with_config(parent_for_run, nvim_exe)

    # Pulizia: se abbiamo usato una temp_dir solo per --run (senza output/deploy),
    # dopo l'esecuzione di Neovim cancelliamo tutto.
    if args.run and not (args.deploy or args.output):
        shutil.rmtree(temp_root)
        if not args.quiet:
            print("Temporary configuration removed.")
    else:
        # In tutti gli altri casi, rimuoviamo la temp_root (già copiata)
        shutil.rmtree(temp_root)

    if not args.quiet:
        print(f"Package manager template for '{args.package_manager}' is ready (commented out).")
        print("Every time you start Neovim with this config, it will print the generation info.")


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        print("\nInterrupted by user. Cleaning up...", file=sys.stderr)
        sys.exit(1)
